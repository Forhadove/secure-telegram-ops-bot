# ==============================================================================
# SECURE TELEGRAM BOT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the real '.env' file to version control!
# ==============================================================================

# Your Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Comma-separated Telegram User IDs for authorized administrators
# Example: WHITELISTED_ADMINS=123456789,987654321
WHITELISTED_ADMINS=123456789
